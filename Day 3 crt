// Problem 6 
// Print 1 to 10 using a do-while loop

#include <iostream>
using namespace std;

int main() {
    int i = 10;
    do {
        cout << i << " ";
        i--;
    } while(i >= 1);
    return 0;
}


//Problem 7 ----
//Factorial  of a number 

int main(){
       int n;
       cin>>n;
       int fact = 1;

       for(int i = n ;  i>= 1 ; i--){
        fact = fact * i;
       }

       cout << fact; 
         return 0 ;
}


//Problem 8 ---
//Fibonachi series

int main(){
       int n ;
       cin >> n ;
       int c;

       int a = 0 ;
       int b = 1;

       for(int i = 0 ; i<n; i++ ){
        cout << a << " ";
        c = a + b ;
        a = b ;
        b = c ;
       }
        
         return 0 ;
}
