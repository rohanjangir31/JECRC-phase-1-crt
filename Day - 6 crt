#include <iostream>
using namespace std;
class Student
{
public:
    string name;
    int age;
    void introduce()
    {
        cout << "Hi there , this person name is " << name << " and his age is " << age << "\n";
    }
};
int main()
{
    Student s1, s2;
    s1.name = "Rohan";
    s1.age = 24;
    s2.name = "Amaan";
    s2.age = 38;
    s1.introduce();
    s2.introduce();

    return 0;
}
